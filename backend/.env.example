# ==============================================================================
# ShopQ Backend Environment Configuration Template
# Copy this file to .env for local development.
# In Production (Render/Cloud), set these via the host environment dashboard.
# NEVER commit the actual .env file or production secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Environment
# ------------------------------------------------------------------------------
# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Debug Mode: true enables detailed logs and error traces; MUST be false in production
DEBUG=true

# Project metadata
PROJECT_NAME="ShopQ Backend API"
VERSION=1.0.0
API_PREFIX=/api

# Server Host & Port binding
# Local: 0.0.0.0:8000
# Cloud/Render: Render provides $PORT dynamically (default 10000)
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Security & Cryptography
# ------------------------------------------------------------------------------
# Cryptographic secret key for session signing and internal token verification
# In production, generate a secure random 32-byte hex string:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=shopq-dev-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 3. CORS Configuration (Local vs Production Separation)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO trailing slashes).
#
# Local Development (Vite on :5173 / React dev server):
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
#
# Production Example (Vercel Frontend deployment):
# ALLOWED_ORIGINS=https://shopq.vercel.app,https://shopq-frontend.vercel.app

# ------------------------------------------------------------------------------
# 4. LLM & External AI Providers
# ------------------------------------------------------------------------------
# Google Gemini API Key for product analysis, sentiment, and reasoning
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Protection Gates
# ------------------------------------------------------------------------------
# Sliding window rate limit for sensitive analysis endpoint (POST /api/analyze)
RATE_LIMIT_ANALYZE_RPM=10
RATE_LIMIT_WINDOW_SECONDS=60

# SSRF Protection DNS resolution timeout (seconds)
SSRF_TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------------------------
# 6. Web Data Scraper Gateway
# ------------------------------------------------------------------------------
# ScraperAPI key for live e-commerce webpage data acquisition
# Obtain at: https://www.scraperapi.com/
SCRAPERAPI_KEY=your_scraperapi_key_here

# Preferred product extraction provider. ScraperAPI is used if Firecrawl fails.
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key_here

# Fresh cached offers are reused for this many seconds. A provider outage can
# still show the last verified observation, visibly marked as stale.
LIVE_PRICE_CACHE_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 7. Supabase Database & Star Schema Connection
# ------------------------------------------------------------------------------
# Supabase PostgreSQL database connection parameters for analytics & DWDM
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 8. Logging & Observability
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 9. Model & Rules Versioning
# ------------------------------------------------------------------------------
MODEL_VERSION=shopq-decision-v2.1
DECISION_RULES_VERSION=rules-2026.10
MATCHING_MODEL_VERSION=match-v1
