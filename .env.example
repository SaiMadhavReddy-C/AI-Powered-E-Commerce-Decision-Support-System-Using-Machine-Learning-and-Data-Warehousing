# ==============================================================================
# ShopQ Full-Stack Environment Configuration Template
# Copy this file to .env for unified local development.
# NEVER commit production secret keys or actual .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ShopQ Backend API"
VERSION=1.0.0
API_PREFIX=/api

HOST=0.0.0.0
PORT=8000

# Security Secret Key (Generate via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=shopq-dev-secret-key-change-in-production

# CORS Allowed Origins (Comma-separated, no trailing slashes)
# Local:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Production:
# ALLOWED_ORIGINS=https://shopq.vercel.app

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiting & Protection
RATE_LIMIT_ANALYZE_RPM=10
RATE_LIMIT_WINDOW_SECONDS=60
SSRF_TIMEOUT_SECONDS=5.0
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_APP_ENV=development
VITE_APP_NAME=ShopQ
# Local:
VITE_API_BASE_URL=http://localhost:8000
# Production (Render):
# VITE_API_BASE_URL=https://shopq-backend.onrender.com
VITE_ENABLE_MOCK_FALLBACK=true
