# ==============================================================================
# ShopQ Frontend - Environment Configuration Template
# Copy this file to .env.local for local Vite development.
# In Vercel, configure these variables under Project Settings -> Environment Variables.
# NOTE: Vite only exposes variables prefixed with VITE_ to the browser client bundle.
# ==============================================================================

# Application Environment ('development', 'staging', 'production')
VITE_APP_ENV=development

# Application Display Name
VITE_APP_NAME=ShopQ

# Backend API Base URL
# Local Development:
VITE_API_BASE_URL=http://localhost:8000

# Production Example (Render backend URL):
# VITE_API_BASE_URL=https://shopq-backend.onrender.com

# Mock Data Fallback Mode
# Set to 'true' to allow graceful fallback to mock catalog when backend or scraping is unavailable
VITE_ENABLE_MOCK_FALLBACK=true
